{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "scripts/*.mts",
    ".githooks/**/*.{ts,mts}",
    ".github/actions/**/*.ts",
    "skills/*/scripts/**/*.{ts,mts}",
    "tests/**/*.{ts,mts}"
  ],
  "project": [
    "scripts/**/*.mts",
    ".githooks/**/*.{ts,mts}",
    ".github/actions/**/*.ts",
    "skills/*/scripts/**/*.{ts,mts}",
    "tests/**/*.{ts,mts}"
  ],
  "ignoreBinaries": ["codex"]
}
