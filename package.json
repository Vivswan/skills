{
  "name": "vivswan-skills-repo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/install-hooks.ts",
    "typecheck": "tsc -p .",
    "validate": "bun .github/actions/validate-skills/validate_skills.ts",
    "link": "bun scripts/link-agents.ts",
    "add": "bun scripts/link-agents.ts --add",
    "smoke": "bun scripts/smoke-test.ts",
    "test": "bun scripts/run-tests.ts",
    "test:cli": "bun scripts/cli-discovery-test.ts",
    "lint": "biome ci .",
    "lint:json": "bun scripts/lint-json.mts",
    "check:fix": "biome check --write .",
    "check:docs": "bun scripts/check-docs.mts",
    "check": "bun run typecheck && bun run lint && bun run lint:json && bun run check:docs && bun run test && bun run validate && bun run smoke",
    "check:staged": "bun scripts/check-staged.mts",
    "sync-xeno": "bun scripts/sync-xeno.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "^1.4.0",
    "oxc-parser": "0.147.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
