{
  "name": "vivswan-skills-repo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "vivswan-skills": "bin/install.mjs"
  },
  "scripts": {
    "hooks": "bun scripts/install-hooks.mts",
    "typecheck": "tsc -p .",
    "validate": "bun .github/actions/validate-skills/validate-skills.ts",
    "link": "bun scripts/link-agents.mts",
    "add": "bun scripts/link-agents.mts --add",
    "smoke": "bun scripts/smoke.mts",
    "test": "bun scripts/run-tests.mts",
    "test:cli": "bun scripts/cli-discovery.mts",
    "lint": "biome ci .",
    "lint:json": "bun scripts/lint-json.mts",
    "check:fix": "biome check --write .",
    "check:docs": "bun scripts/check-docs.mts",
    "check": "bun run typecheck && bun run lint && bun run lint:json && bun run check:docs && bun run test && bun run validate && bun run smoke",
    "check:staged": "bun scripts/check-staged.mts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "diff": "9.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "p-retry": "9.0.0",
    "typescript": "^7.0.2",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  }
}
